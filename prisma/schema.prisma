generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────  ENUMS M0-M3  ──────────────────────────────
enum Escuadron {
  ESCUADRON_OPERACIONES_AEREAS
  ESCUADRON_MANTENIMIENTO
  ESCUADRON_BASE
  PLANA_MAYOR
}

enum Modulo {
  PERSONAS
  AERONAVES
  TIPOS_MISIONES
  ESCALAS
  POST_VUELO
  MANIFIESTO
  SICEM
  INFORMES
  INSPECCION_PREVUELO
}

enum ClasificacionMision {
  OPERACIONAL
  TIPO_VUELO
  LOGISTICA
}

enum CategoriaAeronave {
  PROPIA
  INCAUTADA
}

enum EstadoAeronave {
  DISPONIBLE
  NO_DISPONIBLE
}

enum MotivoNoDisponible {
  ACCIDENTADA
  EN_MANTENIMIENTO
  OTRO
}

enum EspecialidadPersona {
  PILOTO
  COPILOTO
  TECNICO_DE_VUELO
  MECANICO
  ADMINISTRATIVO
  OTRO
}

enum ResultadoLogin {
  EXITOSO
  USUARIO_NO_EXISTE
  CUENTA_INACTIVA
  CREDENCIALES_INVALIDAS
  CUENTA_BLOQUEADA
}

// ─────────────────────────────  ENUMS  M4 ──────────────────────────────

enum EstadoEscala {
  PROGRAMADA
  EN_DESARROLLO
  CUMPLIDA
  ABORTADA
  RECHAZADA
}

enum MotivoAbortada {
  ADOS // Orden Superior
  ADFM // Falta de Material
  ADCA // Condición de la Aeronave
  ADCM // Condiciones Meteorológicas
  ADTI // Técnica de Instrucción
  ADCP // Condiciones del Piloto
}

enum CanalSolicitud {
  WHATSAPP
  PDF
  IMAGEN // foto JPG / PNG
  WORD
  VERBAL // ej. orden presidencial; el archivo se adjunta después
}

enum RolEnVuelo {
  PILOTO
  COPILOTO
  TECNICO_DE_VUELO
}

enum RolAutorizador {
  COMANDANTE
  JEFE_OPERACIONES
  CMDTE_ESC_AEREO
  CMDTE_ESC_MANTENIMIENTO
  JEFE_PERSONAL
}

enum MotivoEscalamiento {
  INICIAL // primer responsable por defecto (Jefe de Operaciones)
  EN_VUELO // el anterior estaba volando → saltó automático
  PARTE_DIARIO // el anterior figura no disponible en el Parte Diario
  DERIVACION_MANUAL // el anterior apretó el botón "derivar"
  ROL_DESACTUALIZADO // el anterior sigue cargado en CargoAutorizacion, pero su Rol ya cambió
  SIN_ASIGNAR // este cargo no tiene a nadie cargado (ni titular ni adjunto)
  REAUTORIZACION // la escala fue editada después de publicada y vuelve a recorrer la cascada desde cero
  CUENTA_INACTIVA
}

enum MotivoNoDisponibleAutorizador {
  TAREA_ADMINISTRATIVA
  FUERA_DE_LA_UNIDAD
  OTRO // usar el campo motivo_detalle
}

enum RolAcuse {
  PILOTO
  COPILOTO
  TECNICO_DE_VUELO
  SUPERVISOR_SEMANA // línea de vuelo, los que preparan la aeronave
}

enum Novedad {
  SIN_NOVEDAD
  INCIDENTE
  ACCIDENTE
}

// ─────────────────────────────  MODELOS M0–M3 ────────────────────────────
model Persona {
  id                  Int                   @id @default(autoincrement())
  nombre              String
  apellido            String
  grado               String
  nro_documento       String                @unique
  fecha_nacimiento    DateTime?
  escuadron           Escuadron
  unidad              String
  especialidades      EspecialidadPersona[] @default([])
  residencia          String?
  telefono            String?
  contacto_emergencia String?
  nro_pasaporte       String?

  // Habilitación médica anual — check manual de Operaciones
  hab_anual_habilitada Boolean @default(false)

  // Habilitación operacional — check manual de Operaciones
  nivel_operacional_habilitado   Boolean   @default(false)
  nivel_operacional_aprobado_por Int?
  nivel_operacional_fecha        DateTime?

  // Campos legacy — se mantienen para no perder datos históricos
  nivel_operacional       String?
  nivel_operacional_vence DateTime?

  activo        Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  usuario                Usuario?
  partes_diarios         ParteDiario[]
  habilitaciones_medicas HabilitacionMedica[]

  tripulaciones EscalaTripulacion[]
  acuses        AcuseRecibo[]
  derivaciones  AutorizadorNoDisponible[]

  @@map("personas")
}

// Historial de habilitaciones médicas semestrales (1P y 2P)
// Un registro por período por persona — no sobreescribe, acumula.
model HabilitacionMedica {
  id           Int      @id @default(autoincrement())
  persona_id   Int
  fecha_examen DateTime @db.Date
  periodo      String // "1P" | "2P"
  anio         Int // año de inicio del período
  vence        DateTime @db.Date

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  persona Persona @relation(fields: [persona_id], references: [id])

  // No se puede cargar dos veces el mismo período para la misma persona
  @@unique([persona_id, periodo, anio])
  @@map("habilitaciones_medicas")
}

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  usuarios     Usuario[]
  permisos_rol PermisoRol[]

  @@map("roles")
}

model Usuario {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  password             String
  activo               Boolean   @default(true)
  sesion_invalidada_en DateTime?
  intentos_fallidos    Int       @default(0)
  bloqueado_hasta      DateTime?
  password_temporal    Boolean   @default(true)

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  persona             Persona             @relation(fields: [persona_id], references: [id])
  persona_id          Int                 @unique
  rol                 Rol                 @relation(fields: [rol_id], references: [id])
  rol_id              Int
  permisos_usuario    PermisoUsuario[]
  cargos_autorizacion CargoAutorizacion[]

  @@map("usuarios")
}

model PermisoRol {
  id             Int     @id @default(autoincrement())
  modulo         Modulo
  puede_ver      Boolean @default(false)
  puede_crear    Boolean @default(false)
  puede_editar   Boolean @default(false)
  puede_eliminar Boolean @default(false)
  puede_reportes Boolean @default(false)

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  rol    Rol @relation(fields: [rol_id], references: [id])
  rol_id Int

  @@unique([rol_id, modulo])
  @@map("permisos_rol")
}

model PermisoUsuario {
  id             Int     @id @default(autoincrement())
  modulo         Modulo
  puede_ver      Boolean @default(false)
  puede_crear    Boolean @default(false)
  puede_editar   Boolean @default(false)
  puede_eliminar Boolean @default(false)
  puede_reportes Boolean @default(false)

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  usuario    Usuario @relation(fields: [usuario_id], references: [id])
  usuario_id Int

  @@unique([usuario_id, modulo])
  @@map("permisos_usuario")
}

model TipoMision {
  id            Int                 @id @default(autoincrement())
  codigo        String              @unique
  nombre        String
  clasificacion ClasificacionMision
  descripcion   String?
  tiene_subtipo Boolean             @default(false)
  subtipo       String?
  activo        Boolean             @default(true)

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  escalas Escala[]

  @@map("tipos_misiones")
}

model Aeronave {
  id                   Int                 @id @default(autoincrement())
  matricula            String              @unique
  tipo                 String
  fabricante           String
  anio_fabricacion     Int
  anio_incorporacion   Int
  capacidad_pasajeros  Int
  tipo_combustible     String
  velocidad_crucero    Int?
  estela_turbulencia   String?
  color                String?
  categoria            CategoriaAeronave
  estado               EstadoAeronave      @default(DISPONIBLE)
  motivo_no_disponible MotivoNoDisponible?
  motivo_otro          String?
  activo               Boolean             @default(true)

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  escalas Escala[]

  @@map("aeronaves")
}

model ParteDiario {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @db.Date
  persona_id  Int
  observacion String?
  creado_por  Int?

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  eliminado_por Int?

  persona Persona @relation(fields: [persona_id], references: [id])

  @@unique([fecha, persona_id])
  @@map("parte_diario")
}

model LogIntentoLogin {
  id         Int            @id @default(autoincrement())
  username   String
  resultado  ResultadoLogin
  ip         String         @default("desconocida")
  created_at DateTime       @default(now())

  @@map("log_intentos_login")
}

// ─────────────────────────────  MODELO M4  ────────────────────────────

//  NOTA 1: la disponibilidad administrativa del personal NO se modela
//  acá. Se reutiliza el modelo ParteDiario que ya existe en M3.
//  NOTA 2: cada escala guarda un inicio y un fin estimado (DateTime)
//  para detectar choques de horario. Una aeronave o un tripulante
//  PUEDEN tener varios vuelos el mismo día si NO se solapan en horario.
//  NOTA 3: la VENTANA DE OCUPACIÓN (despegue → arribo final, incluye
//  tiempo en tierra) es lo que usa el bloqueo de choques. Las HORAS
//  VOLADAS (para SICEM/Informes) son la suma del tiempo de cada tramo
//  del itinerario y NO incluyen el tiempo en tierra. Son números
//  distintos.
// ════════════════════════════════════════════════════════════════════

model Escala {
  id                     Int             @id @default(autoincrement())
  nro_orden              String?         @unique
  // Fecha del vuelo — ya NO se carga a mano en el formulario. Se
  // calcula sola a partir de la hora estimada de salida más temprana
  // del itinerario, convertida a hora de Paraguay (ver
  // fechaEnParaguayDesdeInstante() en lib/fechaHora.js). Por eso es
  // opcional: en un borrador recién creado, antes de cargar el
  // itinerario, todavía no hay ningún valor que calcular.
  fecha                  DateTime?       @db.Date
  hora_despegue_estimada DateTime?
  hora_arribo_estimada   DateTime?
  solicitante            String // ej. FFMM, Presidencia, ANDE, CODI
  observaciones          String?
  estado                 EstadoEscala    @default(PROGRAMADA)
  motivo_abortada        MotivoAbortada? // solo si estado = ABORTADA
  observacion_aborto     String?
  es_borrador            Boolean         @default(true)

  // Resultado de la autorización (uno a uno con la escala)
  autorizada         Boolean         @default(false)
  autorizada_por     Int?
  rol_autoriza       RolAutorizador?
  fecha_autorizacion DateTime?
  // Titular (1) o adjunto (2) de rol_autoriza, en el momento de
  // autorizar O rechazar. Null en escalas resueltas antes de este campo.
  orden_autorizante  Int?

  // Resultado si el autorizante decide RECHAZAR en vez de autorizar —
  // distinto de "abortada" (eso es sobre la aeronave/tripulación en el
  // momento operativo). Rechazada es una decisión humana del autorizante,
  // antes de que la escala llegue a volar.
  rechazada_por  Int?
  motivo_rechazo String?
  fecha_rechazo  DateTime?

  // Relaciones con módulos existentes (M1 y M2) — opcionales en borrador
  aeronave_id     Int?
  aeronave        Aeronave?   @relation(fields: [aeronave_id], references: [id])
  tipo_mision_id  Int?
  tipo_mision     TipoMision? @relation(fields: [tipo_mision_id], references: [id])
  subtipo_elegido String? // el subtipo puntual elegido, si tipo_mision.tiene_subtipo

  // Relaciones hijas (este módulo)
  itinerarios    EscalaItinerario[]
  tripulacion    EscalaTripulacion[]
  solicitudes    Solicitud[]
  autorizaciones EscalaAutorizacion[]
  acuses         AcuseRecibo[]
  post_vuelos    PostVuelo[]

  // Auditoría
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@map("escalas")
}

model EscalaItinerario {
  id        Int    @id @default(autoincrement())
  escala_id Int
  escala    Escala @relation(fields: [escala_id], references: [id])

  orden   Int // 1, 2, 3… el tramo dentro del vuelo
  origen  String // OACI de partida del tramo, ej. SGAS
  destino String // OACI de llegada del tramo, ej. SGFI

  // Tiempos por tramo. Horas del tramo = llegada - salida.
  // El total de la escala = suma de las horas de todos los tramos.
  hora_estimada_salida  DateTime?
  hora_estimada_llegada DateTime?
  hora_real_salida      DateTime?
  hora_real_llegada     DateTime?

  // Auditoría
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@map("escala_itinerarios")
}

model EscalaTripulacion {
  id        Int    @id @default(autoincrement())
  escala_id Int
  escala    Escala @relation(fields: [escala_id], references: [id])

  persona_id   Int
  persona      Persona    @relation(fields: [persona_id], references: [id])
  rol_en_vuelo RolEnVuelo

  // Auditoría
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@unique([escala_id, persona_id])
  @@map("escala_tripulacion")
}

model Solicitud {
  id        Int    @id @default(autoincrement())
  escala_id Int
  escala    Escala @relation(fields: [escala_id], references: [id])

  canal                   CanalSolicitud
  archivo                 String? // ruta del archivo guardado; null si VERBAL
  nombre_archivo_original String?
  recibido_por            Int? // id del usuario que cargó el pedido
  // Cuándo llegó la solicitud a la unidad — dato que carga la persona
  // que registra la escala, no un timestamp automático. Es "solo día"
  // (@db.Date), igual criterio que Escala.fecha: la hora exacta no
  // importa acá, importa el día. Obligatorio.
  fecha_recepcion         DateTime?      @db.Date

  // Auditoría
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@map("solicitudes")
}

model EscalaAutorizacion {
  id        Int    @id @default(autoincrement())
  escala_id Int
  escala    Escala @relation(fields: [escala_id], references: [id])

  // A quién le tocó la responsabilidad en este paso, y por qué le tocó
  rol_autorizador     RolAutorizador
  persona_id          Int? // la persona concreta que tenía ese rol ese día
  // Titular (1) o adjunto (2) del cargo, en el momento en que se evaluó
  // este paso. Null en filas viejas, de antes de este campo.
  orden               Int?
  motivo_escalamiento MotivoEscalamiento

  // Qué pasó en este paso: ¿autorizó acá, o se le pasó al siguiente?
  // true  = esta persona AUTORIZÓ la escala (cierra el recorrido)
  // false = quedó registrada como paso, pero la responsabilidad siguió
  autorizo   Boolean @default(false)
  comentario String?

  // Cuándo ocurrió este paso (para mostrarlo en la interfaz)
  fecha_paso DateTime @default(now())

  // Auditoría
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@map("escala_autorizaciones")
}

model AcuseRecibo {
  id        Int    @id @default(autoincrement())
  escala_id Int
  escala    Escala @relation(fields: [escala_id], references: [id])

  persona_id  Int
  persona     Persona   @relation(fields: [persona_id], references: [id])
  rol         RolAcuse
  fecha_acuse DateTime? // null = todavía no acusó recibo

  // Auditoría
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@unique([escala_id, persona_id, rol])
  @@map("acuses_recibo")
}

model AutorizadorNoDisponible {
  id         Int     @id @default(autoincrement())
  persona_id Int
  persona    Persona @relation(fields: [persona_id], references: [id])

  desde DateTime  @default(now()) // cuándo empezó a derivar
  hasta DateTime? // cuándo volvió; null = sigue derivado

  motivo         MotivoNoDisponibleAutorizador @default(TAREA_ADMINISTRATIVA)
  motivo_detalle String? // texto libre si motivo = OTRO

  // Auditoría
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@map("autorizador_no_disponible")
}

model CargoAutorizacion {
  id Int @id @default(autoincrement())

  // Qué cargo de autorización es (lista cerrada de 5, ya existe el enum)
  rol_autorizador RolAutorizador

  // Quién lo ocupa. Se conecta con Usuario, no con Persona.
  usuario_id Int
  usuario    Usuario @relation(fields: [usuario_id], references: [id])

  // Orden dentro del cargo: 1 = titular, 2 = adjunto, 3… (Forma B)
  orden Int

  // Nombramiento vigente. Al rotar cargos: viejo activo=false, nuevo activo=true.
  // La regla "no dos con el mismo (cargo, orden) activos" se valida en el
  // código del apartado de usuarios (crear y editar), NO acá en la base.
  activo Boolean @default(true)

  // Auditoría (igual que el resto del sistema)
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@map("cargos_autorizacion")
}

// ─────────────────────────────  MODELO M5  ────────────────────────────

model PostVuelo {
  id        Int    @id @default(autoincrement())
  escala_id Int // ya no es @unique — puede haber varias filas por escala a lo largo del tiempo (solo una sin deleted_at a la vez, eso se valida en el código, no en la base)
  escala    Escala @relation(fields: [escala_id], references: [id])

  // Horas de vuelo y de tierra por separado — SICEM (a futuro) va a sumar
  // solo horas_vuelo_minutos por aeronave, sin que se le mezcle tiempo en
  // tierra. total_minutos se guarda para que Informes/Manifiesto puedan
  // sumarlo directo, pero SOLO lo escribe el servidor — nunca es un
  // input, se recalcula siempre que se crea o edita el registro.
  horas_vuelo_minutos  Int
  horas_tierra_minutos Int
  total_minutos        Int

  destino_real          String
  combustible_consumido Decimal? @db.Decimal(8, 2)
  pasajeros             Int?
  aterrizajes           Int

  novedad         Novedad @default(SIN_NOVEDAD)
  detalle_novedad String?

  observaciones String?

  // Auditoría — mismo patrón que el resto del sistema.
  creado_por    Int
  editado_por   Int?
  eliminado_por Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@map("post_vuelos")
}
