generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Escuadron {
  ESCUADRON_OPERACIONES_AEREAS
  ESCUADRON_MATERIAL
  ESCUADRON_BASE
  PLANA_MAYOR
}

enum Modulo {
  PERSONAS
  AERONAVES
  TIPOS_MISIONES
  ESCALAS
  POST_VUELO
  MANIFIESTO
  SICEM
  INFORMES
  INSPECCION_PREVUELO

}

enum CategoriaMision {
  MILITAR
  INSTITUCIONAL
}

enum CategoriaAeronave {
  PROPIA
  INCAUTADA
}

enum EstadoAeronave {
  DISPONIBLE
  NO_DISPONIBLE
}

enum EspecialidadPersona {
  PILOTO
  COPILOTO
  TECNICO_DE_VUELO
  MECANICO
  ADMINISTRATIVO
  OTRO
}

// ============================================
// MÓDULO DE AUTENTICACIÓN Y ROLES
// ============================================

model Persona {
  id                  Int                 @id @default(autoincrement())
  nombre              String
  apellido            String
  grado               String
  nro_documento       String              @unique
  fecha_nacimiento    DateTime?
  escuadron           Escuadron
  unidad              String
  especialidad        EspecialidadPersona?
  residencia          String?
  telefono            String?
  contacto_emergencia String?

  // Habilitaciones con fecha de vencimiento
  nro_pasaporte          String?
  hab_medica_vence       DateTime?
  nivel_operacional      String?
  nivel_operacional_vence DateTime?

  activo Boolean @default(true)

  // Auditoría
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  // Relaciones
  usuario          Usuario?
  historial_grados HistorialGrado[]

  @@map("personas")
}

model HistorialGrado {
  id          Int       @id @default(autoincrement())
  grado       String
  fecha_desde DateTime
  fecha_hasta DateTime?

  // Auditoría
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  // Relaciones
  persona    Persona @relation(fields: [persona_id], references: [id])
  persona_id Int

  @@map("historial_grados")
}

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  // Auditoría
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  // Relaciones
  usuarios        Usuario[]
  permisos_rol    PermisoRol[]

  @@map("roles")
}


model Usuario {
  id                    Int       @id @default(autoincrement())
  username              String    @unique
  password              String
  activo                Boolean   @default(true)
  sesion_invalidada_en  DateTime?

  // Auditoría
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  // Relaciones
  persona           Persona         @relation(fields: [persona_id], references: [id])
  persona_id        Int             @unique
  rol               Rol             @relation(fields: [rol_id], references: [id])
  rol_id            Int
  permisos_usuario  PermisoUsuario[]

  @@map("usuarios")
}

model PermisoRol {
  id              Int     @id @default(autoincrement())
  modulo          Modulo
  puede_ver       Boolean @default(false)
  puede_crear     Boolean @default(false)
  puede_editar    Boolean @default(false)
  puede_eliminar  Boolean @default(false)
  puede_reportes  Boolean @default(false)

  // Auditoría
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  // Relaciones
  rol     Rol @relation(fields: [rol_id], references: [id])
  rol_id  Int

  @@unique([rol_id, modulo])
  @@map("permisos_rol")
}

model PermisoUsuario {
  id              Int     @id @default(autoincrement())
  modulo          Modulo
  puede_ver       Boolean @default(false)
  puede_crear     Boolean @default(false)
  puede_editar    Boolean @default(false)
  puede_eliminar  Boolean @default(false)
  puede_reportes  Boolean @default(false)

  // Auditoría
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  // Relaciones
  usuario     Usuario @relation(fields: [usuario_id], references: [id])
  usuario_id  Int

  @@unique([usuario_id, modulo])
  @@map("permisos_usuario")
}

// ============================================
// MÓDULO TIPOS DE MISIONES
// ============================================

model TipoMision {


  id          Int             @id @default(autoincrement())
  codigo      String          @unique
  nombre      String
  categoria   CategoriaMision
  descripcion String?
  activo      Boolean         @default(true)

  // Auditoría
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  @@map("tipos_misiones")
}

// ============================================
// MÓDULO AERONAVES
// ============================================

model Aeronave {
  id                  Int               @id @default(autoincrement())
  matricula           String            @unique
  tipo                String
  fabricante          String
  anio_fabricacion    Int
  anio_incorporacion  Int
  capacidad_pasajeros Int
  tipo_combustible    String
  velocidad_crucero   Int?
  estela_turbulencia  String?
  color               String?
  categoria           CategoriaAeronave
  estado              EstadoAeronave    @default(DISPONIBLE)
  activo              Boolean           @default(true)

  // Auditoría
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  creado_por    Int?
  editado_por   Int?
  eliminado_por Int?

  @@map("aeronaves")
}